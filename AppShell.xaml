<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BackNavigationTest.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:BackNavigationTest.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="BackNavigationTest">

    <ShellContent
        Title="Dashboard"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="main" />

    <ShellContent
        Title="Projects"
        Icon="{StaticResource IconProjects}"
        ContentTemplate="{DataTemplate pages:ProjectListPage}"
        Route="projects" />

    <ShellContent
        Title="Manage Meta"
        Icon="{StaticResource IconMeta}"
        ContentTemplate="{DataTemplate pages:ManageMetaPage}"
        Route="manage" />
 
    <Shell.FlyoutFooter>
        <Grid Padding="15">
          
            <Button
                Grid.Row="1"
                Text="Uitloggen"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Clicked="OnLogoutClicked"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                Padding="10,5" />
        </Grid>
        
    </Shell.FlyoutFooter>

</Shell>
